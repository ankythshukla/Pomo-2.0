rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserStats(data, userId) {
      return data.userId == userId &&
        data.date is string && data.date.size() == 10 &&
        data.focusMinutesToday is number && data.focusMinutesToday >= 0 &&
        data.sessionsCompletedToday is number && data.sessionsCompletedToday >= 0 &&
        data.streakDays is number && data.streakDays >= 0;
    }

    function isValidTask(data, userId) {
      return data.userId == userId &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 140 &&
        data.completed is bool &&
        data.pomodorosSpent is number && data.pomodorosSpent >= 0 &&
        data.targetPomodoros is number && data.targetPomodoros >= 1;
    }

    function isValidSessionRecord(data, userId) {
      return data.userId == userId &&
        data.id is string && data.id.size() <= 128 &&
        (data.mode == 'focus' || data.mode == 'shortBreak' || data.mode == 'longBreak') &&
        data.durationMinutes is number && data.durationMinutes > 0;
    }

    // User daily stats
    match /users/{userId}/stats/{statId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(statId) && isValidUserStats(request.resource.data, userId);
      allow delete: if isOwner(userId);
    }

    // User focus tasks
    match /users/{userId}/tasks/{taskId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(taskId) && isValidTask(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidId(taskId) && isValidTask(request.resource.data, userId);
      allow delete: if isOwner(userId);
    }

    // User history records
    match /users/{userId}/history/{historyId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(historyId) && isValidSessionRecord(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidId(historyId) && isValidSessionRecord(request.resource.data, userId);
      allow delete: if isOwner(userId);
    }
  }
}
